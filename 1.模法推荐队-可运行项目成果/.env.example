# =============================================================================
# Model Market Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# cp .env.example .env

# --- Application Settings ---
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=false

# --- Authentication ---
# demo: X-User-Id selects a local demo identity; a missing header uses demo admin.
# real: only verified Bearer JWT/OIDC claims are accepted. X-User-Id is ignored.
AUTH_MODE=demo
AUTH_ADAPTER=demo
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWKS_URL=
AUTH_JWT_ALGORITHMS=RS256

# --- Mock Mode ---
# When true, all API endpoints return mock data.
# Set to false when connecting to real services.
ENABLE_MOCK=true

# --- LLM Provider ---
# Options: mock, bigmodel, openai, qwen, deepseek, etc.
LLM_PROVIDER=mock
# Set these to enable LLM-powered parsing and recommendation.
# Never commit a real API key to the repository.
# BigModel / GLM example:
# LLM_PROVIDER=bigmodel
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=<set-in-local-env-only>
#
# OpenAI-compatible Qwen gateway example:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://218.197.140.7:3001/v1/
# LLM_MODEL=Qwen3.5-122B-A10B
# LLM_API_KEY=<set-in-local-env-only>
# Live verification after setting env:
# python scripts/smoke_llm.py
# python scripts/smoke_llm_demand_parser.py
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_SECONDS=30
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_TRACE_ENABLED=true
# Default: data/llm_traces under project root
LLM_TRACE_DIR=

# --- Hybrid Retrieval ---
# Light mode is the default and never downloads BGE-M3 implicitly. Use
# docker-compose.dense.yml for required, offline, manifest-verified competition mode.
RETRIEVAL_RUNTIME_MODE=light
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_DENSE_ENABLED=false
HYBRID_DENSE_WEIGHT=0.50
HYBRID_DENSE_MODEL=BAAI/bge-m3
HYBRID_DENSE_REQUIRED=false
HYBRID_DENSE_OFFLINE=false
HYBRID_DENSE_EXPECTED_DIMENSION=1024
HYBRID_DENSE_EXPECTED_REVISION=
HYBRID_DENSE_MANIFEST=
HYBRID_DENSE_VERIFY_MANIFEST=false
HYBRID_DENSE_CACHE_ENABLED=true
HYBRID_DENSE_CACHE_DIR=data/cache/embeddings

# Deduplicate identical recommendation bursts while preserving per-request
# feedback/audit/version writes. Set to 0 to disable.
RECOMMEND_CACHE_TTL_SECONDS=2

# --- Model Market Integration ---
# Adapter options: demo, real/http. Demo is local desensitized flow and never
# claims to be connected to a real upstream model market.
MODEL_MARKET_ADAPTER=demo
# Leave empty when using demo mode. Never commit a real API key.
MODEL_MARKET_BASE_URL=
MODEL_MARKET_API_KEY=
MODEL_MARKET_TIMEOUT_SECONDS=30

# --- Data Directory ---
# Default: ./data relative to project root
DATA_DIR=

# Mutable runtime state (sessions, audit, feedback, surveys and versions).
# Keep this database outside version control and back it up before migration.
RUNTIME_DB_PATH=data/runtime/runtime.db
MODEL_ASSET_CATALOG_DIR=data/model_catalog
MODEL_ASSET_VERSION=

# --- Docker Compose 端口映射（宿主机端口）---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- 前端开发/代理配置 ---
# 本地 Docker 演示时，浏览器运行在宿主机，通常保持 localhost:8000。
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_PORT=5173
VITE_USE_MOCK=false

# --- 后端 CORS 白名单（逗号分隔）---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Frontend Environment Variables ---
# VITE_API_BASE_URL=http://localhost:8000
# VITE_USE_MOCK=false
# Request input limits
REQUEST_MAX_BODY_BYTES=2097152
JSON_MAX_DEPTH=20
