{
  "template_name": "model_catalog_import_template",
  "version": "1.0.0",
  "description": "模型资产批量导入模板。CSV/XLSX 使用 fields 中的 key 作为表头；JSONL 每行一个对象。",
  "list_separator": "支持 |、；、;、，、,、、 分隔列表字段，也支持 JSON 数组字符串。",
  "fields": [
    {"key": "model_id", "required": true, "type": "string", "example": "MM_001", "description": "模型唯一 ID"},
    {"key": "model_name", "required": true, "type": "string", "example": "小微企业贷前准入模型", "description": "模型名称"},
    {"key": "canonical_name", "required": false, "type": "string", "example": "小微企业贷前准入模型", "description": "标准名称"},
    {"key": "aliases", "required": false, "type": "list", "example": "小微准入|小微A卡", "description": "别名列表"},
    {"key": "source", "required": false, "type": "enum", "example": "imported", "description": "来源：demo/official/imported/model_market"},
    {"key": "asset_version", "required": false, "type": "string", "example": "1.0.0", "description": "资产元数据版本"},
    {"key": "asset_status", "required": false, "type": "string", "example": "cataloged", "description": "资产状态"},
    {"key": "domain", "required": true, "type": "enum", "example": "credit_risk", "description": "业务域"},
    {"key": "business_scenario", "required": true, "type": "list", "example": "小微企业贷前准入|普惠贷款审批", "description": "适用业务场景"},
    {"key": "business_stage", "required": true, "type": "list", "example": "pre_loan", "description": "业务阶段标签"},
    {"key": "customer_segment", "required": false, "type": "list", "example": "small_micro_enterprise", "description": "适用客群"},
    {"key": "model_capability", "required": true, "type": "list", "example": "admission_scoring|credit_rating", "description": "模型能力标签"},
    {"key": "input_fields_required", "required": true, "type": "list", "example": "customer_profile|credit_report", "description": "必需输入字段"},
    {"key": "input_fields_optional", "required": false, "type": "list", "example": "business_operation|asset_liability", "description": "可选输入字段"},
    {"key": "output_fields", "required": true, "type": "list", "example": "risk_score|admission_decision", "description": "输出字段"},
    {"key": "performance_metrics", "required": false, "type": "json_object", "example": "{\"auc\":0.82,\"ks\":0.45}", "description": "性能指标 JSON"},
    {"key": "applicable_conditions", "required": false, "type": "string", "example": "适用于小微企业信用贷款准入。", "description": "适用条件"},
    {"key": "unsuitable_conditions", "required": false, "type": "string", "example": "不适用于无经营流水客户。", "description": "不适用条件"},
    {"key": "compliance_boundary", "required": false, "type": "string", "example": "需符合普惠金融和个人信息保护要求。", "description": "合规边界"},
    {"key": "permission_scope", "required": false, "type": "string", "example": "head_office_internal", "description": "权限范围"},
    {"key": "legal_boundary", "required": false, "type": "string", "example": "仅限内部风控审批辅助。", "description": "法律边界"},
    {"key": "deployment_status", "required": false, "type": "string", "example": "model_market_available", "description": "部署状态"},
    {"key": "api_available", "required": false, "type": "boolean", "example": "true", "description": "是否有可调用 API"},
    {"key": "historical_cases", "required": false, "type": "list", "example": "某农商行准入项目，审批效率提升。", "description": "历史案例"},
    {"key": "tags", "required": false, "type": "list", "example": "credit_risk|pre_loan|small_micro_enterprise|admission_scoring", "description": "标签"},
    {"key": "description", "required": true, "type": "string", "example": "基于客户画像、征信和经营流水的小微企业准入评分模型。", "description": "模型描述"},
    {"key": "input_schema", "required": false, "type": "json_object", "example": "{\"type\":\"object\"}", "description": "输入 schema"},
    {"key": "output_schema", "required": false, "type": "json_object", "example": "{\"type\":\"object\"}", "description": "输出 schema"},
    {"key": "result_schema", "required": false, "type": "json_object", "example": "{\"type\":\"object\"}", "description": "结果 schema"}
  ]
}
